# ============================================================
# ANUClaw Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# ── LLM Provider ─────────────────────────────────────────────
# Options: anthropic | openrouter | openai-compatible | openai-codex | ollama
MODEL_PROVIDER=anthropic

# Anthropic (default)
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenRouter (access 200+ models: deepseek, gemini, gpt, claude, etc.)
# MODEL_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
# OPENROUTER_REASONING_EFFORT=medium
# OPENROUTER_CONFIG_FILE=./openrouter.md
# E-LAB second opinion: Decision 1 checks engine evidence, Gemma MoE reviews it.
# ELAB_DECISION_MODEL=google/gemini-decision-1
# ELAB_REVIEW_MODEL=google/gemma-4-26b-a4b-it

# OpenAI-compatible endpoint
# MODEL_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_API_KEY=your_key
# OPENAI_COMPATIBLE_BASE_URL=https://your-provider.example/v1
# OPENAI_COMPATIBLE_MODEL=your-model-name

# OpenAI / Codex (reuse local codex login)
# MODEL_PROVIDER=openai-codex
# OPENAI_CODEX_MODEL=gpt-4o

# Ollama (local models — no API key needed)
# MODEL_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── E-LAB clinical AI safety (BAA / PHI de-identification) ────
# Whether the configured model provider above is covered by a signed BAA.
# Default false. When false, E-LAB de-identifies clinical free text BEFORE it
# is sent to the provider, then re-identifies the output locally.
LLM_BAA_COVERED=false
# Require de-identification before egress when the provider is not BAA-covered.
# Keep true for pharmacy/clinic use. (Set false only for de-identified test data.)
ELAB_DEID_REQUIRED=true

# ── Channel Tokens ───────────────────────────────────────────
# Enable only the channels you use. Unset = disabled.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_TRIGGER=@ANUClaw

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Feishu / Lark
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# DingTalk
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# Gmail / Email
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ADDRESS=

# Signal
SIGNAL_CLI_PATH=/usr/local/bin/signal-cli
SIGNAL_PHONE_NUMBER=

# Matrix
MATRIX_HOMESERVER_URL=https://matrix.org
MATRIX_USER_ID=
MATRIX_ACCESS_TOKEN=
MATRIX_ROOM_ID=

# iMessage (macOS only)
IMESSAGE_ENABLED=false
IMESSAGE_HANDLE=

# IRC
IRC_SERVER=irc.libera.chat
IRC_PORT=6697
IRC_NICK=ANUClaw
IRC_CHANNEL=#anuclaw

# Nostr
NOSTR_PRIVATE_KEY=
NOSTR_RELAY=wss://relay.damus.io

# QQ (OpenShamrock)
QQ_WEBSOCKET_URL=ws://localhost:3001
QQ_ACCESS_TOKEN=

# WhatsApp (auto-detected when enabled)
WHATSAPP_ENABLED=true
WHATSAPP_SESSION_DIR=.whatsapp-auth

# Local Web UI
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=3721
WEB_PASSWORD=

# ── Agent Settings ───────────────────────────────────────────
TRIGGER_PATTERN=@ANUClaw
MAX_SESSION_MESSAGES=80
CONTAINER_TIMEOUT_MS=300000
CONTAINER_IMAGE=anuclaw-agent:latest
WORKSPACE_DIR=./workspace
GROUPS_DIR=./groups

# ── Hooks ────────────────────────────────────────────────────
HOOKS_ENABLED=true
# HOOKS_CONFIG=./hooks.config.yaml

# ── Memory ───────────────────────────────────────────────────
# dual = file memory (AGENTS.md) + SQLite structured facts
MEMORY_MODE=dual
MEMORY_COMPACTION_THRESHOLD=80

# ── SOUL / Personality ───────────────────────────────────────
# Defaults to ./SOUL.md at project root
# SOUL_PATH=./SOUL.md

# ── Voice Transcription ──────────────────────────────────────
WHISPER_ENABLED=false
# Options: openai-api | local-whisper
WHISPER_BACKEND=openai-api
WHISPER_API_KEY=
# For local whisper.cpp (Apple Silicon)
# WHISPER_MODEL_PATH=./models/ggml-base.bin

# ── Database ─────────────────────────────────────────────────
DB_PATH=./anuclaw.db

# ── PostgreSQL Database ──────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=anuclaw


# ── ANUClaw Dashboard ────────────────────────────────────────
# Set to 'false' to disable the dashboard
DASHBOARD_ENABLED=true

# Port the dashboard server listens on
DASHBOARD_PORT=3722

# REQUIRED. Secret for dashboard session JWTs and E-LAB MFA cookies. There is no
# default: the dashboard refuses to start if this (or, when unset, ANUCLAW_JWT_SECRET)
# is missing, blank, shorter than 32 characters, or a placeholder value.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Prefer a different value from ANUCLAW_JWT_SECRET. Never commit a real value.
DASHBOARD_JWT_SECRET=

# ── First administrator bootstrap (no default accounts) ───────
# There is NO built-in admin account or password. On a database with zero
# dashboard users, set BOTH values below and start once: exactly one admin is
# created, then remove the password from your environment. Ignored once any
# user exists. Missing/weak/placeholder values create nothing (startup continues).
# Password: at least 12 characters, 3 of lowercase/uppercase/digit/symbol, not a
# common password, and not containing the email name. Never commit real values.
ANUCLAW_BOOTSTRAP_ADMIN_EMAIL=
ANUCLAW_BOOTSTRAP_ADMIN_PASSWORD=

# REQUIRED for audit export: HMAC key that signs exported audit bundles. Separate
# from the JWT secrets; no default (export answers 503 when unset). 32+ chars.
ANUCLAW_AUDIT_HMAC_SECRET=

# ── ANUClaw API Platform ──────────────────────────────────────
# Set to 'false' to disable the API server (messaging-only mode)
API_ENABLED=true

# Port the API server listens on
API_PORT=4000

# REQUIRED. Secret for API tenant JWTs. There is no default: the API server refuses
# to start if this is missing, blank, shorter than 32 characters, or a placeholder.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit a real value.
ANUCLAW_JWT_SECRET=

# SQLite database for tenant/company registrations and API keys
ANUCLAW_TENANT_DB=./data/tenants.db

# SQLite database for patient UID registry (EHR authority store)
ANUCLAW_UID_REGISTRY=./data/uid_registry.db

# Comma-separated list of exact allowed CORS origins. Unset/blank = same-origin only (no cross-origin browser access).
# '*' is accepted only outside production (it is refused at startup when NODE_ENV=production).
# Example: CORS_ORIGINS=https://app.mycompany.com,https://dashboard.mycompany.com
CORS_ORIGINS=

# ── CDS v3 — SMART on FHIR / CDS Hooks auth (plan §6.5) ───────
# Guards the /cds-services invocation and /cds/review/* endpoints. FAIL CLOSED:
# the API refuses to start while the CDS routes are mounted without secure auth.
# There is no setting that turns CDS auth off.
#
# Mount the CDS routes at all? (default true). Set false to run the API without them.
CDS_ENABLED=true
#
# Normal (enforced) mode REQUIRES an asymmetric key source — one of:
#   CDS_JWKS_URI        issuer JWKS endpoint (preferred; key resolved by `kid`)
#   CDS_JWT_PUBLIC_KEY  issuer RS/ES public-key PEM (use \n for newlines)
# and CDS_JWT_SECRET must be EMPTY (HS256 is forbidden outside demo mode).
CDS_JWT_PUBLIC_KEY=
CDS_JWKS_URI=
# HS256 shared secret — only accepted with ANUCLAW_DEMO_MODE=true (min 32 chars,
# no placeholder). Leave empty otherwise, or startup fails.
CDS_JWT_SECRET=
# Asymmetric-only verification. Defaults to true; setting false fails startup
# outside demo mode.
CDS_REQUIRE_ASYMMETRIC=true
# REQUIRED in enforced mode: comma-separated allowlist of token issuers (`iss`)
CDS_TRUSTED_ISSUERS=
# REQUIRED in enforced mode: expected audience (`aud`) — this CDS service's public URL
CDS_AUDIENCE=
# Scopes required for review/read endpoints, and additionally for sign-off
CDS_REQUIRED_SCOPES=user/Patient.read
CDS_SIGNOFF_SCOPES=user/MedicationRequest.write
# CDS_AUTH_ENABLED=false is no longer supported and makes startup fail.

# ── Local demo mode (default OFF) ──────────────────────────────
# ANUCLAW_DEMO_MODE=true is for a developer machine only. It does NOT disable
# authentication: CDS requests still need a valid token. It additionally allows
# the HS256 CDS_JWT_SECRET (dev tokens) and binds the API to 127.0.0.1.
# Refused unless NODE_ENV is unset, "development" or "test" (never "production").
ANUCLAW_DEMO_MODE=false

# Admin API key for tenant clinical-grant management (X-Admin-Key header).
# Leave blank to DISABLE the admin API entirely (fail-closed → 503).
ADMIN_API_KEY=

# ── Logging ──────────────────────────────────────────────────
# Options: debug | info | warn | error
LOG_LEVEL=info
LOG_FILE=./logs/anuclaw.log

# ── Model spend budgets (optional; unset = tracked but uncapped) ──
# Daily (UTC) budgets in USD, enforced with durable reservations before each model call. If set and the
# spend ledger is unavailable, model calls are REFUSED (fail closed). Cost is provider-reported only.
ANUCLAW_MODEL_DAILY_BUDGET_USD=
ANUCLAW_MODEL_DAILY_BUDGET_PER_SCOPE_USD=
# Per-call reservation overrides (conservative engineering defaults, NOT prices), e.g. {"ocr":0.05,"review":0.02}
ANUCLAW_MODEL_RESERVE_USD=


# ── Public scientific data connectors (research-only; see docs/SCIENCE-DATA.md) ────────────────────────────
# All optional. No credentials are needed or accepted: only public reference records are fetched.
# ANUCLAW_SCIDATA_DIR=./data/scidata
# ANUCLAW_SCIDATA_MAX_FILE_MB=20
# ANUCLAW_SCIDATA_MAX_GENOME_MBP=12
# ANUCLAW_SCIDATA_MAX_MATRIX_MB=20
# ANUCLAW_SCIDATA_NCBI_MIN_INTERVAL_MS=400
