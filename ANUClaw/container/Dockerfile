FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

# ── System base ───────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget git build-essential ca-certificates gnupg \
    python3 python3-pip python3-dev python3-venv \
    libssl-dev libffi-dev libxml2-dev libxslt1-dev \
    libopenblas-dev liblapack-dev \
    r-base r-base-dev \
    openjdk-17-jre-headless \
    libhdf5-dev \
    unzip zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# ── Node.js (for Claude Code agent SDK) ──────────────────────────────────────
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# ── Claude Code CLI ───────────────────────────────────────────────────────────
RUN npm install -g @anthropic-ai/claude-code

# ── Bioinformatics CLI tools ──────────────────────────────────────────────────
# BLAST+
RUN apt-get update && apt-get install -y --no-install-recommends ncbi-blast+ && rm -rf /var/lib/apt/lists/*

# SAMtools, BCFtools, BEDTools, BWA, minimap2, seqtk
RUN apt-get update && apt-get install -y --no-install-recommends \
    samtools bcftools bedtools bwa minimap2 seqtk \
    && rm -rf /var/lib/apt/lists/*

# FastQC
RUN apt-get update && apt-get install -y --no-install-recommends fastqc && rm -rf /var/lib/apt/lists/*

# GATK (Genome Analysis Toolkit) 4.5.0.0 — supplied from the build context, fetched BEFORE the build by scripts/fetch-container-artifacts.sh.
# Why not download inside the build: the 741 MB release asset sits behind a signed, short-lived redirect on a CDN that delivered ~100 KB/s here. The first
# in-build `wget -q` died (exit 8, no detail) and a later in-build curl could not finish within any sane single-attempt limit while discarding progress on
# retry. The fetch script resumes (Range), detects stalls, logs sanitized statuses, and accepts the file only if its size equals the 741,084,040 bytes GitHub's
# API reports. No provider publishes a checksum for this release, so the SHA-256 is trust-on-first-use: the fetch script prints and records it; pin it with
# --build-arg GATK_SHA256=<hex>. Integrity is additionally checked here (size, optional pinned digest, `unzip -t`).
ARG GATK_SHA256=""
COPY vendor/gatk-4.5.0.0.zip /tmp/gatk.zip
RUN test "$(stat -c%s /tmp/gatk.zip)" = "741084040" \
    && { [ -z "$GATK_SHA256" ] || echo "$GATK_SHA256  /tmp/gatk.zip" | sha256sum -c -; } \
    && echo "gatk.zip sha256: $(sha256sum /tmp/gatk.zip | cut -d' ' -f1)" \
    && unzip -tq /tmp/gatk.zip && unzip -q /tmp/gatk.zip -d /opt/ && rm /tmp/gatk.zip \
    && ln -s /opt/gatk-4.5.0.0/gatk /usr/local/bin/gatk

# Nextflow
RUN curl -s https://get.nextflow.io | bash && mv nextflow /usr/local/bin/

# NOTE: the `|| true` that used to follow the Vina and PyMOL installs is gone — a missing tool must fail the build, not be silently omitted.
# AutoDock Vina (molecular docking)
RUN apt-get update && apt-get install -y --no-install-recommends autodock-vina && rm -rf /var/lib/apt/lists/*

# OpenBabel (chemical format conversion)
RUN apt-get update && apt-get install -y --no-install-recommends openbabel && rm -rf /var/lib/apt/lists/*

# PyMOL (protein structure rendering)
RUN apt-get update && apt-get install -y --no-install-recommends pymol && rm -rf /var/lib/apt/lists/*

# ── Python environment ────────────────────────────────────────────────────────
# CPython 3.12 (Ubuntu 24.04), one venv, installed from a HASH-LOCKED closure (container/python/core.lock.txt, generated by
# scripts/lock-container-python.sh from real PyPI metadata for linux/aarch64): exact versions, every wheel verified against the SHA-256 PyPI
# publishes, wheels only (no build-time surprises). The previous unpinned `pip install` groups were replaced because the resolver showed that
# some tools do not resolve here at all (see container/python/optional.in and docs/CONTAINER-CONTRACT.md); they are NOT silently dropped:
# they are an explicit, separate image (container/Dockerfile.optional) and are not part of this image.
RUN python3 -m venv /opt/anuclaw-env
ENV PATH="/opt/anuclaw-env/bin:$PATH"
COPY python/core.lock.txt /tmp/core.lock.txt
# BuildKit cache mount: wheels already downloaded survive a failed/slow attempt (the lock is hash-pinned, so cached files are re-verified). torch is the
# +cpu build from the PyTorch CPU index (exact pin + hash, see scripts/lock-container-python.sh).
RUN --mount=type=cache,target=/root/.cache/pip pip install --default-timeout=120 --retries 10 --require-hashes --only-binary=:all: --extra-index-url https://download.pytorch.org/whl/cpu -r /tmp/core.lock.txt && rm /tmp/core.lock.txt

# Snakemake: own venv with an exact pin. It cannot join the wheels-only hash lock because its dependency `connection_pool` is source-only (pure Python,
# built from sdist here). System `pip3 install` is not an option on Ubuntu 24.04 (externally managed, PEP 668). NOT hash-locked — stated, not hidden.
RUN python3 -m venv /opt/snakemake-env && /opt/snakemake-env/bin/pip install --no-cache-dir "snakemake==9.27.2" && ln -s /opt/snakemake-env/bin/snakemake /usr/local/bin/snakemake

# ── Workspace setup ───────────────────────────────────────────────────────────
# The container runs as the HOST user's uid/gid (docker --user), never root: `claude --dangerously-skip-permissions`
# refuses root, and bind-mounted files stay owned by the host user. Directories are world-writable (sticky) for that reason.
RUN mkdir -p /workspace/group /workspace/output /workspace/skills /workspace/media \
    && chmod 1777 /workspace/group /workspace/output

# Container contract entrypoint (see docs/CONTAINER-CONTRACT.md): reads credentials from the first stdin line.
COPY entrypoint.js /usr/local/bin/anuclaw-entrypoint
RUN chmod 755 /usr/local/bin/anuclaw-entrypoint

WORKDIR /workspace

# ── Entrypoint ────────────────────────────────────────────────────────────────
# Skills are mounted read-only at /workspace/skills, group memory/context at /workspace/group, optional media read-only
# at /workspace/media, and agent outputs go to /workspace/output. Credentials arrive on stdin only.
ENTRYPOINT ["node", "/usr/local/bin/anuclaw-entrypoint"]
