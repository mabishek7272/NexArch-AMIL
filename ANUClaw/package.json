{
  "name": "anuclaw",
  "version": "1.0.0",
  "description": "Unified AI Research & Medical Assistant Platform — built by AMGI (Abi and Anu Research Initiative)",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write src",
    "container": "./container/build.sh",
    "skills:list": "tsx scripts/skills.ts list",
    "skills:search": "tsx scripts/skills.ts search",
    "skills:install": "tsx scripts/skills.ts install",
    "check:provider": "tsx scripts/check-provider.ts",
    "check:config": "tsx scripts/check-config.ts",
    "probe:models": "tsx scripts/probe-models.ts",
    "verify:local": "tsx scripts/verify-local.ts",
    "openapi:v1": "tsx -e \"require('fs').writeFileSync('docs/openapi-v1.json', JSON.stringify(require('./src/api/openapi-v1').buildOpenApiV1(), null, 2) + '\\n')\"",
    "cds:seal": "tsx scripts/cds-seal.ts",
    "cds:test": "vitest run src/cds",
    "cds:preview": "tsx scripts/cds-preview.ts",
    "elab:demo": "tsx scripts/elab-demo-server.ts",
    "start:api": "tsx scripts/start-api.ts",
    "start:dashboard": "tsx scripts/start-dashboard.ts",
    "dashboard:dev": "cd dashboard && npm run dev",
    "dashboard:build": "cd dashboard && npm install && npm run build",
    "validate": "tsx scripts/validate.ts",
    "study:ocr": "tsx scripts/ocr-study.ts",
    "openapi:study": "tsx scripts/gen-openapi-study.ts",
    "openapi:aikosh": "tsx scripts/gen-openapi-aikosh.ts",
    "aikosh:inventory": "scripts/aikosh-inventory.sh",
    "aikosh:eval": "tsx scripts/aikosh-eval.ts",
    "pv:demo": "tsx scripts/pv-synthetic-run.ts",
    "validate:vectors": ".venv-ocr/bin/python -I scripts/gen-validation-vectors.py > src/validation/validation-vectors.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^1.0.0",
    "@anthropic-ai/sdk": "^0.54.0",
    "@slack/bolt": "^3.22.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "axios": "^1.9.0",
    "baileys": "^6.7.18",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron": "^3.5.0",
    "discord.js": "^14.18.0",
    "docx": "9.15.4",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "form-data": "^4.0.2",
    "helmet": "^8.0.0",
    "irc-framework": "^4.9.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "matrix-js-sdk": "^37.0.0",
    "multer": "^1.4.5-lts.2",
    "node-telegram-bot-api": "^0.66.0",
    "nodemailer": "^6.10.1",
    "nostr-tools": "^2.10.4",
    "openai": "^4.97.0",
    "pdf-lib": "1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "qrcode-terminal": "^0.12.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.0",
    "@types/node-telegram-bot-api": "^0.64.8",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "@types/ssh2": "^1.15.5",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "playwright-core": "1.65.1",
    "prettier": "^3.5.3",
    "ssh2": "^1.17.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "bioinformatics",
    "drug-discovery",
    "medical",
    "claude",
    "anthropic",
    "chatbot",
    "research"
  ],
  "author": "AMGI Research — Abi and Anu (https://github.com/amgi-research)",
  "license": "MIT"
}
