diff --git a/services/backend-api/scripts/grant-session.ts b/services/backend-api/scripts/grant-session.ts
new file mode 100644
index 0000000..a7875da
--- /dev/null
+++ b/services/backend-api/scripts/grant-session.ts
@@ -0,0 +1,34 @@
+/**
+ * Operator tool: grant (or revoke) a clinician's access to ONE session for exports that require an explicit grant.
+ * Usage: npx ts-node scripts/grant-session.ts <clinician-username> <sessionId> [--revoke] --by <operator-name>
+ * There is intentionally no HTTP route that grants access. Every change is written to the audit log.
+ */
+import { PrismaClient } from "@prisma/client";
+
+async function main() {
+  const args = process.argv.slice(2);
+  const revoke = args.includes("--revoke");
+  const byIdx = args.indexOf("--by");
+  const by = byIdx >= 0 ? args[byIdx + 1] : undefined;
+  const [username, sessionId] = args.filter((a, i) => !a.startsWith("--") && args[i - 1] !== "--by");
+  if (!username || !sessionId || !by?.trim()) {
+    console.error("Usage: npx ts-node scripts/grant-session.ts <clinician-username> <sessionId> [--revoke] --by <operator-name>");
+    process.exit(1);
+  }
+  const prisma = new PrismaClient();
+  try {
+    const clinician = await prisma.clinician.findUnique({ where: { username } });
+    const session = await prisma.session.findUnique({ where: { id: sessionId } });
+    if (!clinician || !session) { console.error("Unknown clinician or session; nothing changed."); process.exit(2); }
+    if (revoke) {
+      const r = await prisma.clinicianSessionGrant.updateMany({ where: { clinicianId: clinician.id, sessionId, revokedAt: null }, data: { revokedAt: new Date() } });
+      console.log(`Revoked ${r.count} grant(s).`);
+    } else {
+      const existing = await prisma.clinicianSessionGrant.findFirst({ where: { clinicianId: clinician.id, sessionId, revokedAt: null } });
+      if (existing) console.log("Already granted.");
+      else { await prisma.clinicianSessionGrant.create({ data: { clinicianId: clinician.id, sessionId, grantedBy: by.trim() } }); console.log("Granted."); }
+    }
+    await prisma.auditLogEntry.create({ data: { clinicianId: clinician.id, clinicianUsername: clinician.username, action: revoke ? "revoke_session_access" : "grant_session_access", sessionId } });
+  } finally { await prisma.$disconnect(); }
+}
+main();
