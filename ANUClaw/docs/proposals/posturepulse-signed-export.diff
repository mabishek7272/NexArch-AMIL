+-- Explicit clinician -> session access grants (used by the signed export; see docs/proposals/posturepulse-signed-export.md).
+-- NO backfill, on purpose: every existing session starts with NO grants, so nothing becomes exportable by assumption.
+-- A grant is created only by an operator (scripts/grant-session.ts) and is revocable; the clinician who SIGNED a report
+-- for a session is separately authorised for that session by the server-recorded sign-off, not by this table.
+CREATE TABLE "ClinicianSessionGrant" (
+    "id" TEXT NOT NULL,
+    "clinicianId" TEXT NOT NULL,
+    "sessionId" TEXT NOT NULL,
+    "grantedBy" TEXT NOT NULL,
+    "grantedAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "revokedAt" TIMESTAMP(3),
+    CONSTRAINT "ClinicianSessionGrant_pkey" PRIMARY KEY ("id")
+);
+CREATE INDEX "ClinicianSessionGrant_clinicianId_sessionId_idx" ON "ClinicianSessionGrant"("clinicianId", "sessionId");
+ALTER TABLE "ClinicianSessionGrant" ADD CONSTRAINT "ClinicianSessionGrant_clinicianId_fkey" FOREIGN KEY ("clinicianId") REFERENCES "Clinician"("id") ON DELETE RESTRICT ON UPDATE CASCADE;
+ALTER TABLE "ClinicianSessionGrant" ADD CONSTRAINT "ClinicianSessionGrant_sessionId_fkey" FOREIGN KEY ("sessionId") REFERENCES "Session"("id") ON DELETE RESTRICT ON UPDATE CASCADE;
