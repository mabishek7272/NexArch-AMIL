@@ -0,0 +1,30 @@
+import { ForbiddenException, Injectable, Logger } from "@nestjs/common";
+import { PrismaService } from "../common/prisma.service";
+
+/**
+ * Server-verified authorisation of ONE clinician for ONE session. The clinician role alone is never enough, and neither is anything
+ * a role-only route lets a clinician do to themselves. A clinician is authorised iff, in the database:
+ *   (a) the clinician account exists (the token's subject is looked up; a deleted account's still-valid token fails), AND
+ *   (b) there is a non-revoked ClinicianSessionGrant for exactly (clinicianId, sessionId), created by an operator.
+ * There is deliberately NO other path. In particular "signed the report" is NOT accepted: POST /reports/:id/sign-off is guarded by role
+ * only, so any clinician could sign any draft and thereby award themselves export access to a session they were never given.
+ * Nothing is inferred from caller-supplied tenant ids, patient names or model output. No grant = denied (fail closed), and "no such
+ * session" is indistinguishable from "not yours" (same 403) so the route is not an existence oracle.
+ */
+@Injectable()
+export class SessionAccessService {
+  private readonly logger = new Logger(SessionAccessService.name);
+  constructor(private readonly prisma: PrismaService) {}
+
+  async assertClinicianMayAccess(clinicianId: unknown, sessionId: string): Promise<void> {
+    const deny = (why: string): never => {
+      this.logger.warn(`session access denied (${why})`);       // no ids, names or content in the log
+      throw new ForbiddenException("You are not authorised for this session.");
+    };
+    if (typeof clinicianId !== "string" || !clinicianId || typeof sessionId !== "string" || !sessionId) return deny("missing identity");
+    const clinician = await this.prisma.clinician.findUnique({ where: { id: clinicianId } });
+    if (!clinician) return deny("unknown clinician");
+    const grant = await this.prisma.clinicianSessionGrant.findFirst({ where: { clinicianId, sessionId, revokedAt: null } });
+    if (!grant) return deny("no explicit grant");
+  }
+}
