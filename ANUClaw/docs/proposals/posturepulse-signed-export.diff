@@ -0,0 +1,75 @@
+import { ForbiddenException } from "@nestjs/common";
+import { SessionAccessService } from "./session-access.service";
+import { SignedExportController } from "./signed-export.controller";
+
+type Grant = { clinicianId: string; sessionId: string; revokedAt: Date | null };
+type Report = { sessionId: string; status: string; signedBy: string | null };
+
+function world(opts: { clinicians?: string[]; grants?: Grant[]; reports?: Report[] }) {
+  const clinicians = new Set(opts.clinicians ?? ["A", "B"]);
+  const grants = opts.grants ?? [], reports = opts.reports ?? [];
+  const prisma = {
+    clinician: { findUnique: jest.fn(async ({ where }: any) => (clinicians.has(where.id) ? { id: where.id } : null)) },
+    clinicianSessionGrant: { findFirst: jest.fn(async ({ where }: any) => grants.find((g) => g.clinicianId === where.clinicianId && g.sessionId === where.sessionId && (where.revokedAt === null ? g.revokedAt === null : true)) ?? null) },
+    assessmentReport: { findFirst: jest.fn(async ({ where }: any) => reports.find((r) => r.sessionId === where.sessionId && r.status === where.status && r.signedBy === where.signedBy) ?? null) },
+  };
+  return new SessionAccessService(prisma as never);
+}
+const g = (clinicianId: string, sessionId: string, revokedAt: Date | null = null): Grant => ({ clinicianId, sessionId, revokedAt });
+const ok = (p: Promise<void>) => expect(p).resolves.toBeUndefined();
+const denied = (p: Promise<void>) => expect(p).rejects.toBeInstanceOf(ForbiddenException);
+
+describe("SessionAccessService: the clinician role alone is never enough", () => {
+  it("clinician A cannot access clinician B's session", async () => {
+    const w = world({ grants: [g("B", "s-B")] });
+    await denied(w.assertClinicianMayAccess("A", "s-B"));
+    await ok(w.assertClinicianMayAccess("B", "s-B"));
+  });
+  it("an explicit grant authorises exactly that session and no other", async () => {
+    const w = world({ grants: [g("A", "s1")] });
+    await ok(w.assertClinicianMayAccess("A", "s1")); await denied(w.assertClinicianMayAccess("A", "s2"));
+  });
+  it("SIGNING IS NOT AUTHORISATION: a clinician who signed (or drafted) a session's report through the role-only route gets no export access without a grant", async () => {
+    // sign-off is role-only upstream, so any clinician can create exactly this state for any session; it must confer nothing
+    for (const status of ["released", "draft", "rejected"]) await denied(world({ reports: [{ sessionId: "s1", status, signedBy: "A" }] }).assertClinicianMayAccess("A", "s1"));
+  });
+  it("a revoked grant no longer authorises", async () => {
+    await denied(world({ grants: [g("A", "s1", new Date())] }).assertClinicianMayAccess("A", "s1"));
+  });
+  it("FAIL CLOSED: no grants (every pre-existing session after migration, signed or not) → denied for everyone", async () => {
+    const w = world({}); await denied(w.assertClinicianMayAccess("A", "s1")); await denied(w.assertClinicianMayAccess("B", "s1"));
+  });
+  it("FAIL CLOSED: missing / malformed identity is denied before any lookup", async () => {
+    const w = world({ grants: [g("A", "s1")] });
+    for (const id of [undefined, null, "", 0, {}, ["A"]]) await denied(w.assertClinicianMayAccess(id, "s1"));
+    await denied(w.assertClinicianMayAccess("A", ""));
+  });
+  it("FAIL CLOSED: a valid-looking token for a clinician account that no longer exists is denied even with a grant row", async () => {
+    await denied(world({ clinicians: ["B"], grants: [g("A", "s1")] }).assertClinicianMayAccess("A", "s1"));
+  });
+  it("a non-existent session is indistinguishable from an unauthorised one (same 403 message; no existence oracle)", async () => {
+    const w = world({ grants: [g("A", "real")] });
+    const msg = async (id: string) => (await w.assertClinicianMayAccess("A", id).catch((e) => e)).message;
+    expect(await msg("does-not-exist")).toBe(await msg("someone-elses"));
+  });
+  it("caller-supplied hints are ignored: only the verified id and the route's session id are consulted", async () => {
+    const w = world({ grants: [g("B", "s1")] });
+    // the controller passes req.user.sub and the route param only; an attacker-controlled body/header never reaches the service
+    expect(SignedExportController.prototype.export.length).toBeLessThanOrEqual(2);
+    await denied(w.assertClinicianMayAccess("A", "s1"));
+  });
+});
+
+describe("controller: authorisation runs BEFORE anything is built or read", () => {
+  it("a denied clinician never reaches the export builder; an authorised one does; missing req.user fails closed", async () => {
+    const build = jest.fn(async () => ({ payload: {}, signature: "s" }));
+    const access = world({ grants: [g("A", "s1")] });
+    const c = new SignedExportController({ build } as never, access);
+    await expect(c.export("s1", { user: { sub: "B" } })).rejects.toBeInstanceOf(ForbiddenException);
+    await expect(c.export("s1", {})).rejects.toBeInstanceOf(ForbiddenException);
+    await expect(c.export("s1", { user: {} })).rejects.toBeInstanceOf(ForbiddenException);
+    expect(build).not.toHaveBeenCalled();
+    await expect(c.export("s1", { user: { sub: "A" } })).resolves.toMatchObject({ signature: "s" });
+    expect(build).toHaveBeenCalledWith("s1");
+  });
+});
