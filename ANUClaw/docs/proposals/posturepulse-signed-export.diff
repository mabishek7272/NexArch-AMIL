@@ -0,0 +1,97 @@
+import { createHash, createHmac } from "node:crypto";
+import { ForbiddenException, NotFoundException, ServiceUnavailableException } from "@nestjs/common";
+import { canonicalJson } from "../reports/canonical-json";
+import { SignedExportService } from "./signed-export.service";
+
+const SECRET = "x".repeat(40);
+const NOW = new Date("2026-11-17T10:00:00.000Z");
+const ENV = { EXPORT_SIGNING_SECRET: SECRET };
+const WITHHELD_REASON = "patient John Doe mentioned in the note";
+
+// The authorised view: the withheld row (and its free-text reason) is NOT in it. Only the count is.
+const view = {
+  reportId: "r1", sessionId: "s1", reportVersion: 1, status: "released",
+  rows: [{ metricKey: "a", excluded: null, estimate: { value: 1.2, uncertainty: 0.8 } }],
+  signOff: { clinicianId: "c1", signedAt: "2026-11-17T09:00:00.000Z", contentSha256: "d".repeat(64) },
+};
+
+function build(over: { released?: unknown; consent?: Record<string, unknown> } = {}) {
+  const sessions = { get: jest.fn().mockResolvedValue({ id: "s1", subjectPseudoId: "subj", protocolId: "p", protocolVersion: "v", deploymentContext: "clinic_supervised", consentRecordId: "c1", retentionPolicy: { x: 1 }, calibrationRef: null, state: "ClinicianReview", createdAt: new Date("2026-11-17T08:00:00Z"), safetySnapshot: { secret: "must-not-leak" } }) };
+  const consent = { get: jest.fn().mockResolvedValue({ id: "c1", subjectPseudoId: "subj", scopes: ["derived_events"], grantedAt: new Date("2026-11-17T07:00:00Z"), revokedAt: null, withdrawalRequestedAt: null, ...over.consent }) };
+  const events = { listForSessionByType: jest.fn().mockResolvedValue([{ payload: { symptomReportId: "sr1", sessionId: "s1" } }]) };
+  const reports = { latestReleasedView: jest.fn().mockResolvedValue("released" in over ? over.released : { view, rowsWithheld: 1 }) };
+  return new SignedExportService(sessions as never, consent as never, events as never, reports as never);
+}
+
+describe("SignedExportService", () => {
+  it("signs canonical JSON of the payload with HMAC-SHA256 (independently re-computable, also after a JSON round trip)", async () => {
+    const b = await build().build("s1", NOW, ENV);
+    expect(b.signature).toBe(createHmac("sha256", SECRET).update(canonicalJson(b.payload)).digest("hex"));
+    const overTheWire = JSON.parse(JSON.stringify(b));                         // what the consumer actually parses
+    expect(createHmac("sha256", SECRET).update(canonicalJson(overTheWire.payload)).digest("hex")).toBe(b.signature);
+  });
+
+  it("exports ONLY the subject-authorised view: withheld rows and their reasons are absent, the count is stated", async () => {
+    const b = await build().build("s1", NOW, ENV);
+    expect(JSON.stringify(b)).not.toContain(WITHHELD_REASON);
+    expect((b.payload.report as any).rows).toHaveLength(1);
+    expect(b.payload.view).toEqual({ kind: "subject_authorized", rowsWithheld: 1, viewSha256: createHash("sha256").update(canonicalJson(view)).digest("hex") });
+    expect((b.payload.report as any).signOff.contentSha256).toBe("d".repeat(64));      // carried as a signed claim, not recomputable from the view
+  });
+
+  it("states the signature scheme honestly and carries key id, bundle id and issue time", async () => {
+    const a = await build().build("s1", NOW, { ...ENV, EXPORT_SIGNING_KEY_ID: "2026-11" });
+    const b = await build().build("s1", NOW, ENV);
+    expect(a.payload).toMatchObject({ signatureScheme: "hmac-sha256/shared-secret", keyId: "2026-11", issuedAt: NOW.toISOString(), issuer: "posturepulse-backend-api" });
+    expect(b.payload.keyId).toBe("v1");
+    expect(a.payload.bundleId).not.toBe(b.payload.bundleId);                              // unique per export
+  });
+
+  it("maps consent/session to the schema shapes and leaks no internal fields", async () => {
+    const b = await build().build("s1", NOW, ENV);
+    expect(b.payload.consentRecord).toEqual({ consentRecordId: "c1", subjectPseudoId: "subj", scopes: ["derived_events"], grantedAt: "2026-11-17T07:00:00.000Z", revokedAt: null, withdrawalRequestedAt: null });
+    expect(Object.keys(b.payload.session).sort()).toEqual(["calibrationRef", "consentRecordId", "createdAt", "deploymentContext", "protocolId", "protocolVersion", "retentionPolicy", "sessionId", "state", "subjectPseudoId"]);
+    expect(JSON.stringify(b)).not.toContain("must-not-leak");
+  });
+
+  it("refuses when consent is revoked, withdrawal was requested, or the derived_events scope is missing — nothing is signed", async () => {
+    for (const consent of [{ revokedAt: new Date() }, { withdrawalRequestedAt: new Date() }, { scopes: ["raw_video"] }]) {
+      await expect(build({ consent }).build("s1", NOW, ENV)).rejects.toBeInstanceOf(ForbiddenException);
+    }
+  });
+
+  it("any change to the payload changes the signature", async () => {
+    const a = await build().build("s1", NOW, ENV);
+    const b = await build({ released: { view, rowsWithheld: 0 } }).build("s1", NOW, ENV);
+    expect(a.payload.view).not.toEqual(b.payload.view);
+    expect(createHmac("sha256", SECRET).update(canonicalJson({ ...a.payload, keyId: "other" })).digest("hex")).not.toBe(a.signature);
+  });
+
+  it("refuses (503) without a secret, with a short one or with a malformed key id; never signs with a guessable key", async () => {
+    for (const env of [{}, { EXPORT_SIGNING_SECRET: "" }, { EXPORT_SIGNING_SECRET: "short" }, { EXPORT_SIGNING_SECRET: "y".repeat(31) }, { ...ENV, EXPORT_SIGNING_KEY_ID: "../x" }]) {
+      await expect(build().build("s1", NOW, env)).rejects.toBeInstanceOf(ServiceUnavailableException);
+    }
+  });
+
+  it("404 pending_review when nothing is released (drafts are never exported)", async () => {
+    await expect(build({ released: null }).build("s1", NOW, ENV)).rejects.toBeInstanceOf(NotFoundException);
+  });
+
+  it("key rotation: the key id is part of the signed payload, a new secret/key id yields an independent valid signature, and any tampering is detectable", async () => {
+    const old = await build().build("s1", NOW, { EXPORT_SIGNING_SECRET: SECRET, EXPORT_SIGNING_KEY_ID: "old" });
+    const next = await build().build("s1", NOW, { EXPORT_SIGNING_SECRET: "z".repeat(40), EXPORT_SIGNING_KEY_ID: "new" });
+    const mac = (secret: string, payload: unknown) => createHmac("sha256", secret).update(canonicalJson(payload)).digest("hex");
+    expect(old.signature).toBe(mac(SECRET, old.payload)); expect(next.signature).toBe(mac("z".repeat(40), next.payload));
+    expect(old.payload.keyId).toBe("old"); expect(next.payload.keyId).toBe("new");
+    expect(mac("z".repeat(40), old.payload)).not.toBe(old.signature);                    // the old bundle does not verify under the new key
+    const tampered = JSON.parse(JSON.stringify(old)); tampered.payload.report.rows[0].estimate.value = 0;
+    expect(mac(SECRET, tampered.payload)).not.toBe(old.signature);                        // value tamper
+    const swapped = JSON.parse(JSON.stringify(old)); swapped.payload.keyId = "new";
+    expect(mac(SECRET, swapped.payload)).not.toBe(old.signature);                         // key-id swap
+  });
+
+  it("an unreleased report and revoked consent yield nothing to sign (no bundle object exists to leak)", async () => {
+    await expect(build({ released: null }).build("s1", NOW, ENV)).rejects.toBeInstanceOf(NotFoundException);
+    await expect(build({ consent: { revokedAt: new Date() } }).build("s1", NOW, ENV)).rejects.toBeInstanceOf(ForbiddenException);
+  });
+});
diff --git a/services/backend-api/src/signed-export/signed-export.service.ts b/services/backend-api/src/signed-export/signed-export.service.ts
new file mode 100644
index 0000000..36cc264
--- /dev/null
+++ b/services/backend-api/src/signed-export/signed-export.service.ts
@@ -0,0 +1,91 @@
+import { ForbiddenException, Injectable, NotFoundException, ServiceUnavailableException } from "@nestjs/common";
+import { createHash, createHmac, randomUUID } from "node:crypto";
+import { ConsentService } from "../consent/consent.service";
+import { EventsService } from "../events/events.service";
+import { canonicalJson } from "../reports/canonical-json";
+import { ReportsService } from "../reports/reports.service";
+import { SessionsService } from "../sessions/sessions.service";
+
+export const MIN_SIGNING_SECRET_CHARS = 32;
+export const SIGNATURE_SCHEME = "hmac-sha256/shared-secret";
+const KEY_ID = /^[A-Za-z0-9_.-]{1,64}$/;
+
+export interface SignedExportPayload {
+  consentRecord: Record<string, unknown>;
+  session: Record<string, unknown>;
+  /** The subject-AUTHORISED view: rows a clinician withheld are NOT included. */
+  report: Record<string, unknown>;
+  symptomReports: Array<Record<string, unknown>>;
+  issuedAt: string;
+  issuer: string;
+  /** Which secret signed (non-secret; lets the verifier rotate keys). */
+  keyId: string;
+  /** Unique per export (audit trail / replay evidence). */
+  bundleId: string;
+  /** HMAC with a SHARED secret: anyone who can verify can also forge. This is service attribution, not independent clinician attribution. */
+  signatureScheme: typeof SIGNATURE_SCHEME;
+  /** viewSha256 = sha256(canonicalJson(report)) of the report AS EXPORTED, so a consumer can check the view independently of signOff.contentSha256 (which covers withheld rows and is only an upstream claim when rowsWithheld > 0). */
+  view: { kind: "subject_authorized"; rowsWithheld: number; viewSha256: string };
+}
+export interface SignedExportBundle {
+  payload: SignedExportPayload;
+  /** hex HMAC-SHA256 over canonicalJson(payload). */
+  signature: string;
+}
+
+const iso = (v: Date | string | null | undefined): string | null => (v ? new Date(v).toISOString() : null);
+
+/**
+ * A bundle a downstream system (ANUClaw) can verify OFFLINE with a shared secret. It carries ONLY what the report's own subject
+ * would be shown: the subject-authorised view of the latest RELEASED report, consent + session, symptom reports. Withheld rows and
+ * their free-text reasons are never exported - a valid signature is not permission to disclose them. Because the sign-off digest
+ * covers the withheld rows, the digest cannot be recomputed from this view; it is carried as a SIGNED CLAIM
+ * (`report.signOff.contentSha256`), and `view.rowsWithheld` says whether that gap exists.
+ *
+ * Refused (403) when consent is revoked or a withdrawal was requested, or the consent lacks the derived_events scope.
+ */
+@Injectable()
+export class SignedExportService {
+  constructor(
+    private readonly sessions: SessionsService,
+    private readonly consent: ConsentService,
+    private readonly events: EventsService,
+    private readonly reports: ReportsService
+  ) {}
+
+  async build(sessionId: string, now: Date = new Date(), env: NodeJS.ProcessEnv = process.env): Promise<SignedExportBundle> {
+    const secret = env.EXPORT_SIGNING_SECRET;
+    if (!secret || secret.length < MIN_SIGNING_SECRET_CHARS) {
+      throw new ServiceUnavailableException(`Signed export is not configured (EXPORT_SIGNING_SECRET must be at least ${MIN_SIGNING_SECRET_CHARS} characters).`);
+    }
+    const keyId = env.EXPORT_SIGNING_KEY_ID ?? "v1";
+    if (!KEY_ID.test(keyId)) throw new ServiceUnavailableException("EXPORT_SIGNING_KEY_ID is not a valid identifier.");
+
+    const session = await this.sessions.get(sessionId);
+    const released = await this.reports.latestReleasedView(sessionId);
+    if (!released) throw new NotFoundException({ status: "pending_review" });
+    const consent = await this.consent.get(session.consentRecordId);
+    if (consent.revokedAt || consent.withdrawalRequestedAt) throw new ForbiddenException("Consent was revoked or withdrawal was requested; nothing is exported.");
+    if (!(consent.scopes as unknown as string[]).includes("derived_events")) throw new ForbiddenException("The consent record lacks the 'derived_events' scope.");
+    const symptoms = await this.events.listForSessionByType(sessionId, "symptom-report");
+
+    const payload: SignedExportPayload = {
+      consentRecord: {
+        consentRecordId: consent.id, subjectPseudoId: consent.subjectPseudoId, scopes: consent.scopes,
+        grantedAt: iso(consent.grantedAt), revokedAt: iso(consent.revokedAt), withdrawalRequestedAt: iso(consent.withdrawalRequestedAt),
+      },
+      session: {
+        sessionId: session.id, subjectPseudoId: session.subjectPseudoId, protocolId: session.protocolId, protocolVersion: session.protocolVersion,
+        deploymentContext: session.deploymentContext, consentRecordId: session.consentRecordId, retentionPolicy: session.retentionPolicy,
+        calibrationRef: session.calibrationRef, state: session.state, createdAt: iso(session.createdAt),
+      },
+      report: released.view as unknown as Record<string, unknown>,
+      symptomReports: symptoms.map((e) => e.payload as Record<string, unknown>),
+      issuedAt: now.toISOString(),
+      issuer: "posturepulse-backend-api",
+      keyId, bundleId: randomUUID(), signatureScheme: SIGNATURE_SCHEME,
+      view: { kind: "subject_authorized", rowsWithheld: released.rowsWithheld, viewSha256: createHash("sha256").update(canonicalJson(released.view)).digest("hex") },
+    };
+    return { payload, signature: createHmac("sha256", secret).update(canonicalJson(payload)).digest("hex") };
+  }
+}
