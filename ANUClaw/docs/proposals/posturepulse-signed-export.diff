+import "reflect-metadata";
+import { JwtAuthGuard } from "../auth/jwt-auth.guard";
+import { ROLES_KEY } from "../auth/roles.decorator";
+import { RolesGuard } from "../auth/roles.guard";
+import { SignedExportController } from "./signed-export.controller";
+
+describe("SignedExportController access control", () => {
+  const handler = SignedExportController.prototype.export;
+  it("requires a verified token AND the clinician role (subject and report-access tokens are not clinicians)", () => {
+    const guards = Reflect.getMetadata("__guards__", handler) as unknown[];
+    expect(guards).toEqual([JwtAuthGuard, RolesGuard]);                           // order matters: JwtAuthGuard populates request.user first
+    expect(Reflect.getMetadata(ROLES_KEY, handler)).toEqual(["clinician"]);
+  });
+  it("is audited and never cached", () => {
+    expect(Reflect.getMetadata("__interceptors__", handler)).toHaveLength(1);
+    expect(Reflect.getMetadata("__headers__", handler)).toEqual([{ name: "Cache-Control", value: "no-store" }]);
+  });
+});
